{
  "name": "@punkdevs/closet-cli",
  "version": "0.1.3",
  "description": "CLI to install and maintain AI agent plugin files (Claude Code, Codex, ...) in a project from a self-hosted closet-registry",
  "type": "module",
  "license": "MIT",
  "author": "punkmachine",
  "homepage": "https://github.com/punkmachine/closet-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punkmachine/closet-cli.git"
  },
  "bugs": {
    "url": "https://github.com/punkmachine/closet-cli/issues"
  },
  "keywords": [
    "cli",
    "ai-agents",
    "claude-code",
    "codex",
    "plugin-manager"
  ],
  "bin": {
    "closet-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/templates",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "release:patch": "pnpm version patch && git push --follow-tags && pnpm publish",
    "release:minor": "pnpm version minor && git push --follow-tags && pnpm publish",
    "release:major": "pnpm version major && git push --follow-tags && pnpm publish"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "semver": "^7.6.3",
    "smol-toml": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/semver": "^7.5.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.17.0"
}
