{
  "name": "punk-ai",
  "version": "0.1.0",
  "description": "CLI to bootstrap and manage .claude/ environment from a remote registry of rules/skills/commands/agents/hooks",
  "type": "module",
  "bin": {
    "punk-ai": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "src/templates",
    "package.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "semver": "^7.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/semver": "^7.5.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.17.0"
}
